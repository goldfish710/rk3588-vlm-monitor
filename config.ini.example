# ============================================
# 嵌入式录像系统配置文件
# 所有参数均可修改，格式: key=value
# ============================================

[main_stream]
width=1920
height=1080
hor_stride=1920
ver_stride=1088
bitrate=4000000
bitrate_max=4500000
bitrate_min=3000000
fps=30
gop=30
buffer_count=4
rtsp_port=8554
rtsp_path=h265
rtp_out_buf_max=600000
rtsp_audio_enable=1

[sub_stream]
width=640
height=480
hor_stride=640
ver_stride=480
bitrate=1500000
bitrate_max=2000000
bitrate_min=1000000
fps=30
gop=15
buffer_count=4
rtsp_path=h264
rtp_out_buf_max=300000

[ai]
model_path=./model/yolov8n-pose.rknn
frame_interval=2
box_thresh=0.25
nms_thresh=0.45

[record]
root_dir=/mnt/sdcard/record_main
slice_sec=300
pre_buffer_sec=5
post_record_sec=5
disk_watermark=0.85

audio_enable=1
audio_device=hw:0,0
audio_rate=44100
audio_channels=2
audio_silence_warn=1
audio_bitrate=24000
audio_mono_source=1
audio_kws_enable=0

[event]
device_id=rk3588_home_001
image_dir=./events/image
database_path=./events/database/events.db

[mqtt]
broker_url=tcp://192.168.5.77:1883
client_id=rk3588_fall_detector_{device_id}
; publish_ack_timeout_ms: QoS1 PUBACK 等待上限；公网/大 payload（快照 base64 27~55KB）需放宽，过小会重发
publish_ack_timeout_ms=5000
topic=home/fall
username=mqtt1
password=请填入你的MQTT密码
keepalive=15
connect_timeout=5

[asr]
asr_enable=1
asr_model_dir=./model
asr_vocab_path=./model/vocab.txt
asr_keywords=我好痛,救命,来人,救救我,帮帮我,你好,我摔倒了，我想你了
asr_cooldown_sec=5
asr_silence_gate=1
asr_debug_text_log=1
asr_debug_wav_path=
asr_text_log_file=./events/asr_text.txt
asr_segment_timeout_ms=800

[chat]
chat_enable=1
llm_api_host=api.deepseek.com
llm_api_key=sk-请填入你的API_KEY
llm_model=deepseek-v4-flash
tts_api_host=openspeech.bytedance.com
tts_app_id=1370170447
tts_access_token=请填入你的火山TTS_TOKEN
tts_voice_type=zh_female_vv_uranus_bigtts
tts_cluster=volcano_tts
wake_word=你好,你好啊,在吗,小嘟小嘟,小嘟在吗,在吗小嘟
playback_device=hw:0,0
wake_timeout_sec=10
idle_timeout_sec=30
assistant_name=小嘟
system_prompt=你的名字叫{name}。用口语化的中文回复。
max_tokens=768
temperature=1
tts_speed_ratio=1.1

[vlm_pipeline]
; ★ 公网部署前必须设置 remote_token，否则任何人知道 topic 就能控制摄像头（空=不校验）
; 详见 docs/公网MQTT部署清单.md
remote_enable=1
remote_token=
remote_voice=0
status_interval_sec=60
confirm_timeout_ms=30000
